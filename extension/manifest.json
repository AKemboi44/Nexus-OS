{
  "manifest_version": 3,
  "name": "Nexus Research AI",
  "version": "1.0.4",
  "description": "Research discovery and evidence synthesis in your browser.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "identity"
  ],
  "host_permissions": [
    "https://nexus-os-production-2e14.up.railway.app/*",
    "https://mdjgrtkjjcwmhuhpsjsk.supabase.co/*"
  ],
  "action": {
    "default_title": "Open Nexus Research AI Panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
